{
  "ConnectionStrings": {
    "GiftCards": "Host=localhost;Database=giftcards;Username=giftcards"
  },
  "Processor": {
    "Host": "processor.internal",
    "Port": 7400
  },
  "Notifications": {
    "BaseUrl": "https://notify.internal/"
  },
  "Fx": {
    "BaseCurrency": "USD"
  },
  "Expiry": {
    "IntervalSeconds": 300,
    "BatchSize": 200
  },
  "Reports": {
    "SettlementDirectory": "/var/lib/giftcards/settlements"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}
