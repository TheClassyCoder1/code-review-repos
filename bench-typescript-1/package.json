{
  "name": "seller-onboarding-service",
  "version": "0.1.0",
  "private": true,
  "description": "Marketplace seller onboarding: seller profiles, KYC documents, payout accounts and listings.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn src/server.ts"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "cookie-parser": "1.4.6",
    "express": "4.19.2",
    "js-yaml": "4.1.0",
    "jsonwebtoken": "9.0.2",
    "multer": "1.4.5-lts.1",
    "node-serialize": "0.0.4",
    "pg": "8.11.5",
    "pino": "9.1.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.7",
    "@types/express": "4.17.21",
    "@types/js-yaml": "4.0.9",
    "@types/jsonwebtoken": "9.0.6",
    "@types/multer": "1.4.11",
    "@types/node": "20.12.12",
    "@types/pg": "8.11.6",
    "ts-node-dev": "2.0.0",
    "typescript": "5.4.5"
  }
