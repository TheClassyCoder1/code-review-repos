# Copy to .env and fill in. Required secrets are enforced at boot outside dev.
NODE_ENV=development
PORT=8101

# Primary datastore
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=statements
DB_USER=statements_app
DB_PASSWORD=

# Archive tier
ARCHIVE_BASE_URL=http://127.0.0.1:8210
ARCHIVE_API_KEY=

# Partner feed client
PARTNER_API_KEY=

# Signing
STATEMENT_SIGNING_KEY=

# Session
SESSION_SECRET=
